{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.p1.invalid/ontology-version.schema.json",
  "title": "OntologyVersionSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "projectId",
    "ontologyId",
    "version",
    "schemaVersion",
    "namespace",
    "classes",
    "datatypeProperties",
    "objectProperties",
    "relations",
    "constraints",
    "terms",
    "createdAt"
  ],
  "properties": {
    "id": {
      "$ref": "https://schemas.p1.invalid/common.schema.json#/$defs/uuid"
    },
    "projectId": {
      "$ref": "https://schemas.p1.invalid/common.schema.json#/$defs/uuid"
    },
    "ontologyId": {
      "$ref": "https://schemas.p1.invalid/common.schema.json#/$defs/uuid"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "namespace": {
      "$ref": "https://schemas.p1.invalid/common.schema.json#/$defs/iri"
    },
    "classes": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.p1.invalid/class.schema.json"
      }
    },
    "datatypeProperties": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.p1.invalid/property.schema.json#/$defs/datatypeProperty"
      }
    },
    "objectProperties": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.p1.invalid/property.schema.json#/$defs/objectProperty"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.p1.invalid/relation.schema.json"
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.p1.invalid/constraint.schema.json"
      }
    },
    "terms": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.p1.invalid/term.schema.json"
      }
    },
    "createdAt": {
      "$ref": "https://schemas.p1.invalid/common.schema.json#/$defs/dateTime"
    }
  }
}
