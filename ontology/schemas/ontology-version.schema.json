
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/p1/ontology-version.schema.json",
  "title": "P1 Ontology Version",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "projectId",
    "ontologyId",
    "version",
    "schemaVersion",
    "namespace",
    "classes",
    "datatypeProperties",
    "objectProperties",
    "relations",
    "createdAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "projectId": {
      "type": "string",
      "format": "uuid"
    },
    "ontologyId": {
      "type": "string",
      "format": "uuid"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "type": "string",
      "minLength": 1
    },
    "namespace": {
      "type": "string",
      "minLength": 1
    },
    "classes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ontologyClass"
      }
    },
    "datatypeProperties": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/datatypeProperty"
      }
    },
    "objectProperties": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/objectProperty"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relation"
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "label": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "language"
      ],
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "minLength": 2
        }
      }
    },
    "ontologyClass": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "projectId",
        "iri",
        "preferredLabels",
        "parentClassIds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "projectId": {
          "type": "string",
          "format": "uuid"
        },
        "iri": {
          "type": "string",
          "minLength": 1
        },
        "preferredLabels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/label"
          }
        },
        "definition": {
          "type": "string"
        },
        "parentClassIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "abstract": {
          "type": "boolean",
          "default": false
        },
        "extensions": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "datatypeProperty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "projectId",
        "iri",
        "domainClassIds",
        "datatypeIri"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "projectId": {
          "type": "string",
          "format": "uuid"
        },
        "iri": {
          "type": "string",
          "minLength": 1
        },
        "domainClassIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "datatypeIri": {
          "type": "string",
          "minLength": 1
        },
        "minCount": {
          "type": "integer",
          "minimum": 0
        },
        "maxCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "objectProperty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "projectId",
        "iri",
        "domainClassIds",
        "rangeClassIds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "projectId": {
          "type": "string",
          "format": "uuid"
        },
        "iri": {
          "type": "string",
          "minLength": 1
        },
        "domainClassIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "rangeClassIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "inversePropertyId": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "characteristics": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "functional",
              "inverseFunctional",
              "transitive",
              "symmetric",
              "asymmetric",
              "reflexive",
              "irreflexive"
            ]
          }
        }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "projectId",
        "objectPropertyId",
        "sourceClassId",
        "targetClassId"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "projectId": {
          "type": "string",
          "format": "uuid"
        },
        "objectPropertyId": {
          "type": "string",
          "format": "uuid"
        },
        "sourceClassId": {
          "type": "string",
          "format": "uuid"
        },
        "targetClassId": {
          "type": "string",
          "format": "uuid"
        },
        "displayLabel": {
          "type": "string"
        }
      }
    }
  }
}
