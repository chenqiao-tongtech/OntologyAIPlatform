{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.p1.invalid/domain.schema.json",
  "title": "Domain",
  "allOf": [
    {
      "$ref": "https://schemas.p1.invalid/common.schema.json#/$defs/projectScoped"
    },
    {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "parentDomainId": {
          "oneOf": [
            {
              "$ref": "https://schemas.p1.invalid/common.schema.json#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name"
      ]
    }
  ],
  "unevaluatedProperties": false
}
