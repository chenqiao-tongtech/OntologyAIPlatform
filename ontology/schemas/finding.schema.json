{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.p1.invalid/finding.schema.json",
  "title": "Finding",
  "allOf": [
    {
      "$ref": "https://schemas.p1.invalid/common.schema.json#/$defs/projectScoped"
    },
    {
      "type": "object",
      "properties": {
        "validationRunId": {
          "$ref": "https://schemas.p1.invalid/common.schema.json#/$defs/uuid"
        },
        "ruleId": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error",
            "critical"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "targetElementId": {
          "oneOf": [
            {
              "$ref": "https://schemas.p1.invalid/common.schema.json#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "detailsRef": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "validationRunId",
        "ruleId",
        "severity",
        "message"
      ]
    }
  ],
  "unevaluatedProperties": false
}
