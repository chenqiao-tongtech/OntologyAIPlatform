{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.p1.invalid/discovery-job.schema.json",
  "title": "DiscoveryJob",
  "allOf": [
    {
      "$ref": "https://schemas.p1.invalid/common.schema.json#/$defs/projectScoped"
    },
    {
      "type": "object",
      "properties": {
        "ontologyId": {
          "oneOf": [
            {
              "$ref": "https://schemas.p1.invalid/common.schema.json#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "providerId": {
          "type": "string",
          "minLength": 1
        },
        "providerVersion": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "queued",
            "running",
            "succeeded",
            "failed",
            "cancelled"
          ]
        },
        "inputSnapshotRef": {
          "type": "string",
          "minLength": 1
        },
        "configuration": {
          "type": "object"
        }
      },
      "required": [
        "providerId",
        "providerVersion",
        "status",
        "inputSnapshotRef",
        "configuration"
      ]
    }
  ],
  "unevaluatedProperties": false
}
