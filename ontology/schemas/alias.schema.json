{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.p1.invalid/alias.schema.json",
  "title": "Alias",
  "allOf": [
    {
      "$ref": "https://schemas.p1.invalid/common.schema.json#/$defs/projectScoped"
    },
    {
      "type": "object",
      "properties": {
        "termId": {
          "$ref": "https://schemas.p1.invalid/common.schema.json#/$defs/uuid"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "language": {
          "type": "string",
          "minLength": 2,
          "maxLength": 35
        },
        "aliasType": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "termId",
        "label",
        "language",
        "aliasType"
      ]
    }
  ],
  "unevaluatedProperties": false
}
